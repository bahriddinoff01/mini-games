# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect" → App frameworks).
# The anon / publishable key is safe to use in the browser: Row Level Security protects the data.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
